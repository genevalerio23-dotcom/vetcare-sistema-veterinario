@model VetCare.Web.Models.CrearConsultaViewModel

@{
    ViewData["Title"] = "Registrar consulta";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <h1 class="mb-2">Registrar consulta clínica</h1>
        <p class="text-muted">
            Registra la atención, el diagnóstico y las observaciones.
        </p>

        @if (TempData["Exito"] is string mensaje)
        {
            <div class="alert alert-success" role="alert">
                @mensaje
            </div>
        }

        @if (Model.Mascotas.Count == 0 ||
                Model.Veterinarios.Count == 0)
        {
            <div class="alert alert-warning">
                Debe existir al menos una mascota y un veterinario activos.
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-controller="Consultas"
                      asp-action="Crear"
                      method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="MascotaId"
                               class="form-label"></label>
                        <select asp-for="MascotaId"
                                asp-items="Model.Mascotas"
                                class="form-select">
                            <option value="">Selecciona una mascota</option>
                        </select>
                        <span asp-validation-for="MascotaId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VeterinarioId"
                               class="form-label"></label>
                        <select asp-for="VeterinarioId"
                                asp-items="Model.Veterinarios"
                                class="form-select">
                            <option value="">Selecciona un veterinario</option>
                        </select>
                        <span asp-validation-for="VeterinarioId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CitaId"
                               class="form-label"></label>
                        <input asp-for="CitaId"
                               type="number"
                               min="1"
                               class="form-control" />
                        <div class="form-text">
                            Déjalo vacío para una atención sin cita.
                            Si indicas una cita, debe corresponder a la
                            mascota y al veterinario seleccionados.
                        </div>
                        <span asp-validation-for="CitaId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Fecha"
                               class="form-label"></label>
                        <input asp-for="Fecha"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               type="datetime-local"
                               step="60"
                               class="form-control" />
                        <span asp-validation-for="Fecha"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Motivo"
                               class="form-label"></label>
                        <textarea asp-for="Motivo"
                                  rows="2"
                                  maxlength="250"
                                  class="form-control"></textarea>
                        <span asp-validation-for="Motivo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Diagnostico"
                               class="form-label"></label>
                        <textarea asp-for="Diagnostico"
                                  rows="3"
                                  maxlength="2000"
                                  class="form-control"></textarea>
                        <span asp-validation-for="Diagnostico"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Observaciones"
                               class="form-label"></label>
                        <textarea asp-for="Observaciones"
                                  rows="3"
                                  maxlength="2000"
                                  class="form-control"></textarea>
                        <span asp-validation-for="Observaciones"
                              class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Guardar consulta
                    </button>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Volver al inicio
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}