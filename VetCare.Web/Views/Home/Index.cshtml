@{
    ViewData["Title"] = "Inicio";

    var puedeRecepcion = User.IsInRole("Administrador")
        || User.IsInRole("Recepcionista");

    var puedeClinica = User.IsInRole("Administrador")
        || User.IsInRole("Veterinario");

    var modulos = new[]
    {
        new
        {
            Titulo = "Clientes",
            Descripcion = "Registra los datos de los propietarios.",
            Controlador = "Clientes",
            Accion = "Crear",
            Boton = "Registrar cliente",
            Permitido = puedeRecepcion
        },
        new
        {
            Titulo = "Mascotas",
            Descripcion = "Registra pacientes y asócialos a su propietario.",
            Controlador = "Mascotas",
            Accion = "Crear",
            Boton = "Registrar mascota",
            Permitido = puedeRecepcion
        },
        new
        {
            Titulo = "Citas",
            Descripcion = "Agenda una atención con el veterinario.",
            Controlador = "Citas",
            Accion = "Crear",
            Boton = "Agendar cita",
            Permitido = puedeRecepcion
        },
        new
        {
            Titulo = "Consultas clínicas",
            Descripcion = "Registra motivos, diagnósticos y observaciones.",
            Controlador = "Consultas",
            Accion = "Crear",
            Boton = "Registrar consulta",
            Permitido = puedeClinica
        },
        new
        {
            Titulo = "Tratamientos",
            Descripcion = "Agrega indicaciones a una consulta existente.",
            Controlador = "Tratamientos",
            Accion = "Crear",
            Boton = "Registrar tratamiento",
            Permitido = puedeClinica
        },
        new
        {
            Titulo = "Historial clínico",
            Descripcion = "Revisa las consultas y tratamientos por mascota.",
            Controlador = "Historial",
            Accion = "Index",
            Boton = "Consultar historial",
            Permitido = puedeClinica
        }
    };
}

<div class="bg-light border rounded-3 p-4 p-md-5 mb-4">
    <h1 class="display-5 fw-bold text-success">VetCare</h1>
    <p class="lead mb-2">Sistema de gestión veterinaria</p>
    <p class="text-muted mb-0">
        Registra propietarios y mascotas, agenda citas y consulta
        la información clínica de cada paciente.
    </p>
</div>

@if (User.Identity?.IsAuthenticated != true)
{
    <div class="alert alert-info">
        <p>Inicia sesión para acceder a los módulos de VetCare.</p>

        <a asp-controller="Cuenta"
           asp-action="Login"
           class="btn btn-success">
            Iniciar sesión
        </a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var modulo in modulos)
        {
            if (modulo.Permitido)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h4">@modulo.Titulo</h2>
                            <p class="text-muted">@modulo.Descripcion</p>

                            <a asp-controller="@modulo.Controlador"
                               asp-action="@modulo.Accion"
                               class="btn btn-success mt-auto">
                                @modulo.Boton
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
}
